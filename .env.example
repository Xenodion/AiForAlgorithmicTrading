# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit real credentials.

# IB Gateway / TWS connection (override broker.yaml defaults)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# Storage paths (leave empty to use defaults under data/)
RAW_DATA_PATH=
ANALYTICS_DATA_PATH=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
